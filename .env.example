# Server-side secrets for the payment API (Vercel -> Project -> Settings -> Environment Variables).
# NEVER commit real values. The browser never sees these.

# Payment gateway (default: razorpay). Use Razorpay TEST keys until you go live.
PAYMENT_GATEWAY=razorpay
# Keep false for test/staging. Live keys are rejected unless explicitly enabled.
PAYMENTS_LIVE_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Webhooks -> secret you chose for https://<your-domain>/api/subscription/webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Firebase Admin service account JSON (raw or base64). Used to verify ID tokens
# and to write subscription/payment records (bypasses security rules by design).
FIREBASE_SERVICE_ACCOUNT=

# Protects /api/cron/subscriptions (Vercel Cron sends it as a Bearer token).
CRON_SECRET=choose-a-long-random-string

# Server-owned paid-subscription grace period (0-30 days; existing default is 3).
SUBSCRIPTION_GRACE_DAYS=3

# ---- Android app: Google Play alternative billing with user choice (India) ----
# Keep false until the app is enrolled (Play Console -> Settings -> Alternative
# billing), Play subscriptions exist and a Play-enabled app build is released.
# While false the Android app stays purchase-free (Play Payments policy).
GOOGLE_PLAY_ALT_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.luxeglow.crm
# Service account JSON (raw or base64) invited in Play Console -> Users and
# permissions with "View financial data" and "Manage orders and subscriptions".
GOOGLE_PLAY_SERVICE_ACCOUNT=
# GST percent included in catalog prices, used to split reported amounts (0 if not GST-registered).
GOOGLE_PLAY_TAX_PERCENT=
# Play subscriptions are <prefix><planId> (glowos_basic ...) with base plans "monthly" and "annual".
GOOGLE_PLAY_PRODUCT_PREFIX=glowos_
# Pub/Sub push endpoint: https://<your-domain>/api/subscription/play-notify?secret=<this value>
GOOGLE_PLAY_RTDN_SECRET=choose-a-long-random-string
